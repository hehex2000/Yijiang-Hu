def _write_daily_values_sheet(writer, all_results: List[Dict]):
    """写入每日市值曲线 Sheet"""
    rows = []
    
    for result in all_results:
        code = result['code']
        
        # 主动量化每日市值（双均线）
        if 'dual_ma_daily' in result and len(result['dual_ma_daily']) > 0:
            for dv in result['dual_ma_daily']:
                rows.append({
                    '股票代码': code,
                    '日期': dv['date'],
                    '双均线市值': dv['portfolio_value'],
                    '海龟市值': None,
                    '定投市值': None
                })
        
        # 主动量化每日市值（海龟）
        if 'turtle_daily' in result and len(result['turtle_daily']) > 0:
            for dv in result['turtle_daily']:
                # 找到对应的行（如果已存在）
                found = False
                for row in rows:
                    if row['股票代码'] == code and row['日期'] == dv['date']:
                        row['海龟市值'] = dv['portfolio_value']
                        found = True
                        break
                
                if not found:
                    rows.append({
                        '股票代码': code,
                        '日期': dv['date'],
                        '双均线市值': None,
                        '海龟市值': dv['portfolio_value'],
                        '定投市值': None
                    })
        
        # 被动量化每日市值（定投）
        if 'dca_daily' in result and len(result['dca_daily']) > 0:
            for dv in result['dca_daily']:
                # 找到对应的行（如果已存在）
                found = False
                for row in rows:
                    if row['股票代码'] == code and row['日期'] == dv['date']:
                        row['定投市值'] = dv['portfolio_value']
                        found = True
                        break
                
                if not found:
                    rows.append({
                        '股票代码': code,
                        '日期': dv['date'],
                        '双均线市值': None,
                        '海龟市值': None,
                        '定投市值': dv['portfolio_value']
                    })
    
    if len(rows) > 0:
        df = pd.DataFrame(rows)
        df.to_excel(writer, sheet_name='每日市值曲线', index=False)


def _write_strategy_comparison_sheet(writer, all_results: List[Dict]):
    """写入策略深度对比 Sheet"""
    rows = []
    
    for result in all_results:
        code = result['code']
        dual_ma = result['dual_ma_metrics']
        dca = result['dca_metrics']
        comp = result['comparison']
        
        # 收益能力对比
        rows.append({
            '股票代码': code,
            '对比维度': '总收益率',
            '主动量化': f"{dual_ma['total_return']:.2%}",
            '被动量化': f"{dca['total_return']:.2%}",
            '结论': '主动更优' if dual_ma['total_return'] > dca['total_return'] else '被动更优'
        })
        
        rows.append({
            '股票代码': code,
            '对比维度': '年化收益率',
            '主动量化': f"{dual_ma['annualized_return']:.2%}",
            '被动量化': f"{dca['annualized_return']:.2%}",
            '结论': '主动更优' if dual_ma['annualized_return'] > dca['annualized_return'] else '被动更优'
        })
        
        # 风险特征对比
        rows.append({
            '股票代码': code,
            '对比维度': '最大回撤',
            '主动量化': f"{dual_ma['max_drawdown']:.2%}",
            '被动量化': f"{dca['max_drawdown']:.2%}",
            '结论': '主动更优' if dual_ma['max_drawdown'] < dca['max_drawdown'] else '被动更优'
        })
        
        rows.append({
            '股票代码': code,
            '对比维度': '夏普比率',
            '主动量化': f"{dual_ma['sharpe_ratio']:.2f}",
            '被动量化': f"{dca['sharpe_ratio']:.2f}",
            '结论': '主动更优' if dual_ma['sharpe_ratio'] > dca['sharpe_ratio'] else '被动更优'
        })
        
        # 交易行为对比
        rows.append({
            '股票代码': code,
            '对比维度': '胜率',
            '主动量化': f"{dual_ma['win_rate']:.2%}",
            '被动量化': f"{dca['win_rate']:.2%}",
            '结论': '主动更优' if dual_ma['win_rate'] > dca['win_rate'] else '被动更优'
        })
        
        rows.append({
            '股票代码': code,
            '对比维度': '交易次数',
            '主动量化': dual_ma['num_trades'],
            '被动量化': dca['num_trades'],
            '结论': '主动更优' if dual_ma['num_trades'] < dca['num_trades'] else '被动更优'
        })
    
    df = pd.DataFrame(rows)
    df.to_excel(writer, sheet_name='策略深度对比', index=False)


