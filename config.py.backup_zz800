}

# ============================================================
# 二、选股配置
# ============================================================
SELECTION = {
    # 是否先执行选股
    #   True  = 自动选股 → 回测
    #   False = 使用下面 stocks_manual 中的股票直接回测
    "enabled": True,

    # 选股基准日期（YYYYMMDD，必须是交易日）
